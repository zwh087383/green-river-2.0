<?xml version="1.0"?>
<package format="3">
  <name>voice</name>
  <version>0.1.0</version>
  <description>Robot speech bridge and ROS2 wrappers for the Green River RAG system.</description>
  <maintainer email="noreply@example.invalid">Green River</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rag_interfaces</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>wheeled_robot_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
